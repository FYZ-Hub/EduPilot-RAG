# 复制为 .env 后按需修改；请勿提交真实密钥。
# 阶段 1 只使用其中与骨架、健康检查相关的字段，其余为后续阶段预留。

APP_ENV=development
APP_NAME=campus-rag-assistant

FRONTEND_PORT=5173
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:////app/data/sqlite/app.db
CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads
MODEL_CACHE_PATH=/app/data/models

EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
# 显式模型快照；留空使用内置固定 revision（绝不跟随可变 main）
EMBEDDING_REVISION=
# 本地 Provider 默认只读缓存，不隐式下载权重（权重需预先放入 MODEL_CACHE_PATH）
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_TIMEOUT_SECONDS=30

RERANK_PROVIDER=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=2
# 显式模型快照；留空使用内置固定 revision（绝不跟随可变 main）
RERANK_REVISION=
# 本地 Provider 默认只读缓存，不隐式下载权重（权重需预先放入 MODEL_CACHE_PATH）
RERANK_LOCAL_FILES_ONLY=true
RERANK_TIMEOUT_SECONDS=30

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_ANSWER_MAX_CHARS=2000
LLM_REWRITE_MAX_CHARS=300

CHUNK_TARGET_CHARS=550
CHUNK_OVERLAP_CHARS=100
DENSE_TOP_K=12
KEYWORD_TOP_K=12
# 送入生成的最终证据条数；硬上限 10，只允许显式调小
RERANK_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=

MAX_UPLOAD_MB=50
LOG_LEVEL=INFO

DEMO_DATASET_ENABLED=true
DEMO_DATASET_PATH=/app/demo
DEMO_DATASET_VERSION=2026.1
DEMO_JOB_POLL_SECONDS=2
DEMO_JOB_LEASE_SECONDS=60

# 前端集中式 API Base URL（浏览器访问宿主机后端）
VITE_API_BASE_URL=http://localhost:8000/api
