# 固化语料的字节必须与生成器输出完全一致（manifest / ground truth 的 SHA-256 具有语义），
# 因此禁止 Git 做换行转换；二进制语料按原样存取。
demo/manifest.json text eol=lf
demo/ground_truth.jsonl text eol=lf
demo/corpus/** -text

# 生成器与测试脚本统一使用 LF
scripts/** text eol=lf

# 根目录运行脚本面向 Windows PowerShell：固定 CRLF（内容仍为 UTF-8 BOM）
/run.ps1 text eol=crlf
/stop.ps1 text eol=crlf

# 字体是二进制资产：覆盖上面的 text/eol 规则，禁止换行转换与文本 diff，
# 否则 Git 会把字体里的 CRLF 字节改写成 LF 并破坏其 SHA-256。
scripts/generator/fonts/*.ttf -text -diff !eol
